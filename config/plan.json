        "6": { "type": "cardio", "mode": "zone2",     "minutes": 60 },
        "0": { "type": "rest" }
      },

      "zone2Guidance": "Bike, rower, or steep-incline treadmill walk while over 200 lb.",

      "sessions": {
        "liftA": {
          "name": "Lift A",
          "exercises": [
            { "id": "trapbar",  "name": "Trap bar deadlift",     "sets": 3, "reps": 5,  "increment": 5,  "unit": "lb" },
            { "id": "bench",    "name": "Barbell bench press",   "sets": 3, "reps": 5,  "increment": 5,  "unit": "lb" },
            { "id": "csrow",    "name": "Chest-supported row",   "sets": 3, "reps": 8,  "increment": 5,  "unit": "lb", "pair": "3" },
            { "id": "facepull", "name": "Face pull",             "sets": 2, "reps": 15, "increment": 5,  "unit": "lb", "pair": "3" },
            { "id": "farmer",   "name": "Farmer's carry, 40 yd", "sets": 3, "reps": 1,  "increment": 10, "unit": "lb ea", "type": "carry" }
          ]
        },
        "liftB": {
          "name": "Lift B",
          "exercises": [
            { "id": "squat",    "name": "Low-bar back squat",       "sets": 3, "reps": 5,  "increment": 5, "unit": "lb" },
            { "id": "ohp",      "name": "Overhead press",           "sets": 3, "reps": 5,  "increment": 5, "unit": "lb" },
            { "id": "chinup",   "name": "Chin-up or lat pulldown",  "sets": 3, "reps": 8,  "increment": 5, "unit": "lb", "pair": "3" },
            { "id": "rdl",      "name": "Romanian deadlift",        "sets": 3, "reps": 8,  "increment": 5, "unit": "lb", "pair": "3" },
            { "id": "suitcase", "name": "Suitcase carry or plank",  "sets": 3, "reps": 1,  "increment": 10, "unit": "lb ea", "type": "carry" }
          ]
        }
      },

      "restGuidance": "Rest 3 min on the first lift, 2–3 min on the second, 90 s on paired accessories.",

      "progression": {
        "onAllRepsCompleted": "increment",
        "onMiss": "repeat",
        "consecutiveMissesBeforeDeload": 2,
        "deloadFactor": 0.9,
        "roundToNearest": 5,
        "layoffDays": 10,
        "layoffFactor": 0.9
      },

      "phases": [
        { "weeks": [1, 2], "stepTarget": 6500,
          "scheduleOverrides": { "2": { "type": "walk", "minutes": 30 },
